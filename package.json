{
  "name": "khaman-crm",
  "private": true,
  "version": "0.1.0",
  "description": "Khaman CRM, a simple WhatsApp-first CRM for small sales teams.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@khaman/web",
    "dev:web": "npm run dev --workspace=@khaman/web",
    "dev:api": "npm run start:dev --workspace=@khaman/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
